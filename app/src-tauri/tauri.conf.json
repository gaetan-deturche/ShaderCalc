{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShaderCalc",
  "version": "0.7.0",
  "identifier": "com.shadercalc.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShaderCalc",
        "width": 1360,
        "height": 860,
        "minWidth": 760,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
