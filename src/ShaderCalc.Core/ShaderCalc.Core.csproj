<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The app is ShaderCalc.exe / ShaderCalc.dll; namespaces stay ShaderCalc.* -->
    <AssemblyName>ShaderCalc.Core</AssemblyName>
    <RootNamespace>ShaderCalc</RootNamespace>
  </PropertyGroup>

  <!-- The reference shown in the app's Docs panel (and by F1) -->
  <ItemGroup>
    <EmbeddedResource Include="Docs/reference.md" LogicalName="ShaderCalc.Docs.reference.md" />
  </ItemGroup>

  <!-- Reference runner: DXC compiles to DXIL, D3D12's WARP adapter runs it on the CPU -->
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.Dxc" Version="3.8.3" />
  </ItemGroup>

</Project>
