<Window x:Class="ShaderCalc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShaderCalc" Icon="Assets/shadercalc.ico" Width="1360" Height="860" MinWidth="760" MinHeight="420"
        Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>
        <!-- Fluent TabItem template (dotnet/wpf release/9.0, top placement only) minus its hardcoded MinWidth="180" -->
        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="Border" MinHeight="34" Padding="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              ContentSource="Header" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="100"/>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource TabViewItemHeaderBackgroundSelected}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource TabViewSelectedItemBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TabViewItemForegroundSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" Text="Starting..."/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ReferenceText" AutomationProperties.AutomationId="ReferenceText"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="FolderText" Opacity="0.7"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8,6,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="SideColumn" Width="420" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="NewButton" AutomationProperties.AutomationId="NewButton" Content="New" Click="OnNewClick" ToolTip="New worksheet (Ctrl+T)"/>
                    <Button x:Name="RenameButton" AutomationProperties.AutomationId="RenameButton" Content="Rename" Margin="6,0,0,0" Click="OnRenameClick"
                            ToolTip="Rename the worksheet (F2)"/>
                    <Button x:Name="DeleteButton" AutomationProperties.AutomationId="DeleteButton" Content="Delete" Margin="6,0,0,0" Click="OnDeleteClick"
                            ToolTip="Send the worksheet to the Recycle Bin"/>
                    <Button Content="Open folder" Margin="6,0,0,0" Click="OnOpenFolderClick" ToolTip="Show the worksheet files in Explorer"/>
                </StackPanel>
                <TabControl x:Name="DocumentTabs" AutomationProperties.AutomationId="DocumentTabs" SelectionChanged="OnDocumentTabChanged"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

            <TabControl x:Name="SideTabs" Grid.Column="2" AutomationProperties.AutomationId="SideTabs">
                <TabItem x:Name="InspectorTab" Header="Inspector">
                    <FlowDocumentScrollViewer x:Name="InspectorViewer" AutomationProperties.AutomationId="InspectorViewer"
                                              VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/>
                </TabItem>
                <TabItem x:Name="DocsTab" Header="Docs">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="80"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*" MinHeight="80"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="DocsSearch" AutomationProperties.AutomationId="DocsSearch" TextChanged="OnDocsSearchChanged"
                                 ToolTip="Search the reference: intrinsics, units, worksheet rules (F1 on a name opens its page)"/>
                        <ListBox x:Name="DocsList" Grid.Row="1" AutomationProperties.AutomationId="DocsList" Margin="0,6,0,0"
                                 SelectionChanged="OnDocsSelectionChanged" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Group}" Opacity="0.55" FontSize="11" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Summary}" Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent"/>
                        <FlowDocumentScrollViewer x:Name="DocsViewer" Grid.Row="3" AutomationProperties.AutomationId="DocsViewer"
                                                  VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
