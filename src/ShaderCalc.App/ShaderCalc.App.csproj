<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ShaderCalc</AssemblyName>
    <RootNamespace>ShaderCalc.App</RootNamespace>
    <ApplicationIcon>Assets\shadercalc.ico</ApplicationIcon>
    <!-- Application.ThemeMode (Fluent theme) is experimental in .NET 9 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShaderCalc.Core\ShaderCalc.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\shadercalc.ico" />
  </ItemGroup>

</Project>
