<Window x:Class="KalkGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:engine="clr-namespace:KalkGui.Engine;assembly=KalkGui.Engine"
        Title="KalkGui" Icon="Assets/kalkgui.ico" Width="1280" Height="820" MinWidth="720" MinHeight="420"
        Loaded="OnLoaded" Activated="OnActivated" Closing="OnClosing" PreviewKeyDown="OnWindowPreviewKeyDown" KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <!-- Fluent TabItem template (dotnet/wpf release/9.0, top placement only) minus its hardcoded MinWidth="180",
             which wraps three tabs onto two rows in the side panel -->
        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="Border" MinHeight="36" Padding="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              ContentSource="Header" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="100"/>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource TabViewItemHeaderBackgroundSelected}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource TabViewSelectedItemBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TabViewItemForegroundSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="10,8,10,6" LastChildFill="False">
            <TextBlock Text="Display" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="DisplayModeBox" Width="170" SelectionChanged="OnDisplayModeChanged"
                      ToolTip="kalk display mode: dev adds hex and binary breakdowns of numbers">
                <ComboBoxItem Content="std (standard)" Tag="std"/>
                <ComboBoxItem Content="dev (developer)" Tag="dev"/>
                <ComboBoxItem Content="raw" Tag="raw"/>
            </ComboBox>
            <Button x:Name="ImportButton" Content="Import module..." Margin="12,0,0,0" Click="OnImportButtonClick"/>
            <Button DockPanel.Dock="Right" Content="Restart engine" Margin="8,0,0,0" Click="OnRestartClick"
                    ToolTip="New kalk engine: reloads config.kalk and the library"/>
            <Button DockPanel.Dock="Right" Content="Clear" Click="OnClearClick" ToolTip="Clear the transcript (Ctrl+L)"/>
        </DockPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="VersionText" Opacity="0.7"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10,0,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#181818" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <RichTextBox x:Name="TranscriptBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                                 FontFamily="{StaticResource MonoFont}" FontSize="14"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseDoubleClick="OnTranscriptDoubleClick">
                        <!-- FlowDocument does not inherit the RichTextBox font -->
                        <FlowDocument x:Name="Transcript" PagePadding="10,8" FontFamily="{StaticResource MonoFont}" FontSize="14" TextAlignment="Left"/>
                    </RichTextBox>

                    <TextBlock x:Name="ErrorText" Grid.Row="1" Visibility="Collapsed" Foreground="#E74856"
                               Padding="12,4" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="13"/>

                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#3A3A3A">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&gt;&gt;&gt;" Foreground="#767676"
                                       FontFamily="{StaticResource MonoFont}" FontSize="14" Margin="10,7,6,0"/>
                            <Button x:Name="EvaluateButton" DockPanel.Dock="Right" Content="=" FontSize="14" MinWidth="34"
                                    VerticalAlignment="Top" Margin="4" ToolTip="Evaluate (Enter)" Click="OnEvaluateClick"/>
                            <avalonEdit:TextEditor x:Name="InputEditor" FontFamily="{StaticResource MonoFont}" FontSize="14"
                                                   Background="Transparent" Foreground="#CCCCCC" MinHeight="34" MaxHeight="220"
                                                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                   Padding="0,7,8,7"
                                                   ToolTip="Enter evaluates · Shift+Enter new line · Tab / Ctrl+Space complete · Up/Down history · F1 docs · Esc cancel"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <TabControl x:Name="SideTabs" Grid.Column="2">
                <TabItem x:Name="DocsTab" Header="Docs">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Search" VerticalAlignment="Center" Margin="2,0,8,0"/>
                            <TextBox x:Name="DocSearchBox" TextChanged="OnDocSearchChanged"
                                     ToolTip="Filter by name, summary or category"/>
                        </DockPanel>

                        <ListBox x:Name="DocList" Grid.Row="1" SelectionChanged="OnDocSelectionChanged"
                                 MouseDoubleClick="OnDocListDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Opacity="0.8" Margin="4,10,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type engine:DocEntry}">
                                    <StackPanel x:Name="EntryRoot">
                                        <TextBlock Text="{Binding Signature}" FontFamily="{StaticResource MonoFont}"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                            <Setter TargetName="EntryRoot" Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent"
                                      ResizeBehavior="PreviousAndNext"/>

                        <DockPanel Grid.Row="3">
                            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Content="Insert into input"
                                    Margin="0,6,0,0" Click="OnDocInsertClick"/>
                            <FlowDocumentScrollViewer x:Name="DocDetails" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem x:Name="LibraryTab" Header="Library">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="LibraryPathText" Opacity="0.7" TextWrapping="Wrap" Margin="2,0,0,6"/>

                        <ListBox x:Name="SymbolList" Grid.Row="1" MouseDoubleClick="OnSymbolDoubleClick"
                                 SelectionChanged="OnSymbolSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type engine:UserSymbol}">
                                    <DockPanel>
                                        <TextBlock x:Name="ConfigTag" DockPanel.Dock="Right" Text="config.kalk" FontSize="11" Opacity="0.6"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                                   ToolTip="Defined in config.kalk; editing it here moves it to the library"/>
                                        <TextBlock x:Name="ErrorTag" DockPanel.Dock="Right" Text="error" FontSize="11" Foreground="#E74856"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                                   ToolTip="{Binding LoadError}"/>
                                        <TextBlock Text="{Binding Summary}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsInLibrary}" Value="False">
                                            <Setter TargetName="ConfigTag" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                            <Setter TargetName="ErrorTag" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="2" Text="Selected entry, or New to add one (Enter applies, Shift+Enter new line, Esc reverts)"
                                   Opacity="0.7" Margin="2,8,0,4" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Row="3" Background="#181818" CornerRadius="4">
                            <avalonEdit:TextEditor x:Name="LibraryEditor" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                   Background="Transparent" Foreground="#CCCCCC" MinHeight="30" MaxHeight="140"
                                                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6,5"/>
                        </Border>
                        <TextBlock x:Name="LibraryErrorText" Grid.Row="4" Visibility="Collapsed" Foreground="#E74856" TextWrapping="Wrap"
                                   FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="2,4,0,0"/>

                        <WrapPanel Grid.Row="5" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="New" Margin="0,0,6,0" Click="OnLibraryNewClick" ToolTip="Empty the editor to add a new entry"/>
                            <Button Content="Apply" Margin="0,0,6,0" Click="OnLibraryApplyClick" ToolTip="Evaluate the edited entry and save it (Enter)"/>
                            <Button Content="Revert" Margin="0,0,16,0" Click="OnLibraryRevertClick" ToolTip="Discard the edit (Esc)"/>
                            <Button Content="Insert" Margin="0,0,6,0" Click="OnSymbolInsertClick"/>
                            <Button Content="Delete" Margin="0,0,6,0" Click="OnSymbolDeleteClick"/>
                            <Button Content="Delete all" Margin="0,0,6,0" Click="OnSymbolResetClick"/>
                            <Button Content="Add to config.kalk" Margin="0,0,6,0" Click="OnSymbolToConfigClick"
                                    ToolTip="Append the definition to config.kalk"/>
                            <Button Content="Open file" Click="OnOpenLibraryClick" ToolTip="Show library.kalk in Explorer"/>
                        </WrapPanel>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ConfigTab" Header="Config">
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock x:Name="ConfigPathText" DockPanel.Dock="Top" Opacity="0.7" TextTrimming="CharacterEllipsis" Margin="2,0,0,6"/>
                        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="Open folder" Margin="0,0,6,0" Click="OnOpenConfigFolderClick"/>
                            <Button Content="Reload" Margin="0,0,6,0" Click="OnReloadConfigClick"/>
                            <Button Content="Save" Margin="0,0,6,0" Click="OnSaveConfigClick" ToolTip="Ctrl+S"/>
                            <Button Content="Save and restart engine" Click="OnSaveAndRestartClick"/>
                        </WrapPanel>
                        <Border Background="#181818" CornerRadius="4">
                            <avalonEdit:TextEditor x:Name="ConfigEditor" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                   Background="Transparent" Foreground="#CCCCCC" ShowLineNumbers="True" Padding="4"/>
                        </Border>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
